import pandas as pd
import numpy as np
from google.colab import files

uploaded = files.upload()

file_name = list(uploaded.keys())[0]

# Read Excel
df = pd.read_excel(file_name)

print("Original Dataset Shape:", df.shape)
print("\nColumn Names:")
print(df.columns.tolist())

print("\n" + "="*60)
print("MISSING VALUES BEFORE CLEANING")
print("="*60)

missing_before = df.isnull().sum()

print(missing_before[missing_before > 0])

if "CouponCode" in df.columns:

    coupon_missing_before = df["CouponCode"].isna().sum()

    # Replace missing CouponCode with No Coupon
    df["CouponCode"] = df["CouponCode"].fillna("No Coupon")

    print("\nCouponCode missing values before:",
          coupon_missing_before)

    print("CouponCode missing values after:",
          df["CouponCode"].isna().sum())

duplicate_rows_before = df.duplicated().sum()

print("\n" + "="*60)
print("DUPLICATE CHECK")
print("="*60)

print("Duplicate complete rows:", duplicate_rows_before)

# Remove duplicate complete rows
df = df.drop_duplicates()

print("Duplicate rows after cleaning:", df.duplicated().sum())

if "OrderID" in df.columns:

    duplicate_order_ids = df["OrderID"].duplicated().sum()

    print("\nDuplicate OrderIDs before cleaning:",
          duplicate_order_ids)

    # Remove duplicate OrderID records
    df = df.drop_duplicates(subset=["OrderID"], keep="first")

    print("Duplicate OrderIDs after cleaning:",
          df["OrderID"].duplicated().sum())

print("\n" + "="*60)
print("DATE COLUMN CHECK")
print("="*60)

# Automatically find columns containing Date
date_columns = [
    col for col in df.columns
    if "date" in col.lower()
]

print("Date columns found:", date_columns)

for col in date_columns:

    # Convert to proper datetime
    df[col] = pd.to_datetime(
        df[col],
        errors="coerce"
    )

    # Convert to standard format
    df[col] = df[col].dt.strftime("%Y-%m-%d")

    print(f"{col}: Date format cleaned")

print("\n" + "="*60)
print("NUMBER COLUMN CHECK")
print("="*60)

number_columns = df.select_dtypes(
    include=["int64", "float64", "Int64", "Float64"]
).columns.tolist()

print("Numeric columns:", number_columns)

for col in number_columns:

    # Convert to numeric safely
    df[col] = pd.to_numeric(df[col], errors="coerce")

    print(f"{col}: Numeric format checked")

print("\n" + "="*60)
print("TEXT COLUMN CHECK")
print("="*60)

text_columns = df.select_dtypes(
    include=["object"]
).columns.tolist()

for col in text_columns:

    # Remove extra spaces
    df[col] = df[col].apply(
        lambda x: x.strip() if isinstance(x, str) else x
    )

    print(f"{col}: Text formatting cleaned")

print("\n" + "="*60)
print("MISSING VALUES AFTER CLEANING")
print("="*60)

missing_after = df.isnull().sum()

print(missing_after[missing_after > 0])

if missing_after.sum() == 0:
    print("\n✓ No missing values remaining.")
else:
    print("\nNote: Some missing values still exist.")
    print("Check the columns listed above.")

print("\n" + "="*60)
print("FINAL DUPLICATE CHECK")
print("="*60)

print("Duplicate complete rows:",
      df.duplicated().sum())

if "OrderID" in df.columns:
    print("Duplicate OrderIDs:",
          df["OrderID"].duplicated().sum())

print("\n" + "="*60)
print("FINAL DATE CHECK")
print("="*60)

for col in date_columns:

    invalid_dates = pd.to_datetime(
        df[col],
        errors="coerce"
    ).isna().sum()

    print(f"{col} - Invalid dates:", invalid_dates)


report = pd.DataFrame({
    "Check": [
        "Original Rows",
        "Original Columns",
        "Duplicate Rows Before",
        "Duplicate Rows After",
        "CouponCode Missing Before",
        "CouponCode Missing After",
        "Remaining Missing Cells"
    ],

    "Result": [
        len(pd.read_excel(file_name)),
        len(df.columns),
        duplicate_rows_before,
        df.duplicated().sum(),
        coupon_missing_before if "CouponCode" in df.columns else "N/A",
        df["CouponCode"].isna().sum()
            if "CouponCode" in df.columns else "N/A",
        df.isnull().sum().sum()
    ]
})

print("\n" + "="*60)
print("CLEANING REPORT")
print("="*60)

print(report)

output_file = "DecodeLabs_Data_Analytics_Project1_Cleaned.xlsx"

with pd.ExcelWriter(output_file, engine="openpyxl") as writer:

    # Cleaned dataset
    df.to_excel(
        writer,
        sheet_name="Cleaned_Data",
        index=False
    )

    # Cleaning report
    report.to_excel(
        writer,
        sheet_name="Cleaning_Report",
        index=False
    )

print("\n" + "="*60)
print("SUCCESS!")
print("="*60)

print("Cleaned file created:")
print(output_file)

files.download(output_file)
